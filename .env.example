# ─────────────────────────────────────────────────────────────
# مساعد الأستاذ — متغيّرات البيئة
# انسخ هذا الملف إلى .env.local للتطوير. لا ترفع .env.local أبدًا.
# ─────────────────────────────────────────────────────────────

# رابط الموقع (لا يُكتب الدومين داخل الكود)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase — مشروع مساعد الأستاذ (منفصل عن BacZone)
# Firebase Console → Project settings → General → Your apps
# هذه القيم عامّة بطبيعتها؛ الحماية تأتي من Security Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── أسرار الخادم فقط (بلا NEXT_PUBLIC_) ──────────────────────
# في الإنتاج تُضاف كـ Worker secrets:  npx wrangler secret put <NAME>
# وفي التطوير المحلي لـ wrangler توضع في .dev.vars

# Firebase service account (JSON في سطر واحد) — Phase 2+
FIREBASE_SERVICE_ACCOUNT=

# Chargily Pay — Phase 13
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test

# Cloudflare R2 — Phase 11
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

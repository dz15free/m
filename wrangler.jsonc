{
  // مساعد الأستاذ — Worker مستقل عن BacZone في نفس حساب Cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prof-baczone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // ملفات المكتبة (خاصة): لا تُقدَّم إلا عبر /api/files بعد التحقق من الحساب والاشتراك
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "prof-baczone-content" }],
  // معاينات الفروع (Workers Builds يشغّل `wrangler preview` لغير فرع الإنتاج). الكتلة الفارغة تكفي:
  // الأصول والتوافق تبقى في المستوى الأعلى، أما الروابط فلا تُورَّث — فلا تصل المعاينة إلى حاوية الإنتاج
  // (ملفات المكتبة تعيد 503 «storage not configured» في المعاينة فقط).
  "previews": {}
  // الدومين (prof.baczone.app) يُربط من لوحة Cloudflare → Workers → Custom Domains
  // الأسرار تُضاف بـ: npx wrangler secret put CHARGILY_SECRET_KEY  (لا تُكتب هنا أبدًا)
}

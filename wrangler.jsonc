{
  // مساعد الأستاذ — Worker مستقل عن BacZone في نفس حساب Cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prof-baczone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
  // ملفات المكتبة (R2): بعد إنشاء الحاوية `prof-baczone-content` من لوحة Cloudflare (R2 ← Create bucket)
  // أضف هذا السطر إلى الإعدادات أعلاه (بعد observability مع فاصلة):
  //   "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "prof-baczone-content" }]
  // دونه يعمل الموقع كاملًا، وتردّ ميزات ملفات المكتبة فقط بـ «غير متاح» (503) بدل أن يفشل النشر.
  // الدومين (prof.baczone.app) يُربط من لوحة Cloudflare → Workers → Custom Domains
  // الأسرار تُضاف بـ: npx wrangler secret put CHARGILY_SECRET_KEY  (لا تُكتب هنا أبدًا)
}

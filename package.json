{
  "name": "prof-baczone",
  "version": "0.1.0",
  "private": true,
  "description": "مساعد الأستاذ — مكتب الأستاذ الرقمي",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run cf-typegen --silent >/dev/null && next typegen && tsc --noEmit",
    "seed:billing": "node scripts/seed-billing.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:rules": "firebase emulators:exec --only firestore --project prof-baczone-rules-test \"node --test firebase/tests/*.test.mjs\"",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "vendor": "node scripts/copy-vendor-assets.mjs",
    "predev": "npm run vendor",
    "prebuild": "npm run vendor && npm run cf-typegen --silent"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10",
    "server-only": "0.0.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "15.31.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.139.0"
  }
}

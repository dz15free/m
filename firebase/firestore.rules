rules_version = '2';

// ─────────────────────────────────────────────────────────────
// مساعد الأستاذ — قواعد Firestore
// المبدأ: كل شيء مغلق افتراضيًا، ثم يُفتح صراحةً.
// الأدوار في Custom Claims (admin / contentEditor / finance)، لا في المستندات.
// المال والاشتراكات تكتبها الخوادم وحدها (Service Account يتجاوز القواعد).
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isEditor() { return isAdmin() || (signedIn() && request.auth.token.contentEditor == true); }
    function isFinance() { return isAdmin() || (signedIn() && request.auth.token.finance == true); }

    function isShortString(v, max) { return v is string && v.size() <= max; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── حدود الخطة ──
    // نفس منطق effectivePlan في الكود: اشتراك/تجربة سارية ⇐ حدودها، وإلا حدود plans/free (أو 2).
    function entPath(uid) { return /databases/$(database)/documents/entitlements/$(uid); }
    function freeMaxClasses() {
      let p = /databases/$(database)/documents/plans/free;
      return exists(p) ? get(p).data.limits.maxClasses : 2;
    }
    function paidActive(uid) {
      return exists(entPath(uid))
        && get(entPath(uid)).data.status in ['trial', 'active']
        && request.time < get(entPath(uid)).data.currentPeriodEnd;
    }
    function maxClasses(uid) {
      return paidActive(uid) && get(entPath(uid)).data.limits.maxClasses > freeMaxClasses()
        ? get(entPath(uid)).data.limits.maxClasses
        : freeMaxClasses();
    }

    // ── حساب المستخدم ────────────────────────────────────────
    match /users/{uid} {
      function validUser(d) {
        return isShortString(d.displayName, 80)
          && d.locale in ['ar', 'fr']
          && d.onboardingDone is bool
          && d.updatedAt == request.time;
      }

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'locale', 'onboardingDone', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.onboardingDone == false
        && validUser(request.resource.data);

      // email وcreatedAt ثابتان؛ onboardingDone لا يعود إلى false
      allow update: if isOwner(uid)
        && changedOnly(['displayName', 'locale', 'onboardingDone', 'updatedAt'])
        && validUser(request.resource.data)
        && (resource.data.onboardingDone == false || request.resource.data.onboardingDone == true);

      allow delete: if false; // حذف الحساب عبر الخادم فقط (مع مهلة تراجع)
    }

    // ── مساحة الأستاذ: عزل تام، لا يصل إليها إلا صاحبها ──────
    // كل مجموعة فرعية مُعرّفة صراحةً بمدقّقاتها؛ ما لم يُعرَّف بعد مغلق.
    match /teachers/{uid} {
      function validTeacher(d) {
        return isShortString(d.firstName, 60) && d.firstName.size() > 0
          && isShortString(d.lastName, 60) && d.lastName.size() > 0
          && d.stage in ['primary', 'middle', 'secondary']
          && isShortString(d.gradeId, 32)
          && isShortString(d.get('gradeCustom', ''), 80)
          && d.wilayaCode is int && d.wilayaCode >= 1 && d.wilayaCode <= 99
          && isShortString(d.directorate, 120)
          && d.presetType in ['primaryGeneralist', 'primarySubject', 'middleSecondary']
          && d.activeYearId is string && d.activeYearId.matches('^[0-9]{4}-[0-9]{4}$')
          && isShortString(d.primarySchoolId, 40)
          && d.updatedAt == request.time;
      }

      // الأدمن يرى الملف المهني فقط (الاسم، المؤسسة…) — لا الأقسام ولا التلاميذ
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'firstName', 'lastName', 'stage', 'gradeId', 'gradeCustom', 'wilayaCode', 'directorate',
             'presetType', 'activeYearId', 'primarySchoolId', 'counters', 'createdAt', 'updatedAt'])
        && request.resource.data.counters == { 'classes': 0, 'assignments': 0, 'students': 0 }
        && request.resource.data.createdAt == request.time
        && validTeacher(request.resource.data);

      // العدّادات وتاريخ الإنشاء لا يعدّلها الملف المهني (تُحدَّث مع إنشاء الأقسام في مراحلها)
      allow update: if isOwner(uid)
        && changedOnly([
             'firstName', 'lastName', 'stage', 'gradeId', 'gradeCustom', 'wilayaCode', 'directorate',
             'presetType', 'activeYearId', 'primarySchoolId', 'updatedAt'])
        && validTeacher(request.resource.data);

      allow delete: if false;

      // المؤسسات (واحدة أو أكثر)
      match /schools/{schoolId} {
        function validSchool(d) {
          return d.keys().hasOnly(['name', 'wilayaCode', 'commune', 'stage', 'directorate', 'createdAt', 'updatedAt'])
            && isShortString(d.name, 120) && d.name.size() > 1
            && d.wilayaCode is int && d.wilayaCode >= 1 && d.wilayaCode <= 99
            && isShortString(d.commune, 80)
            && d.stage in ['primary', 'middle', 'secondary']
            && isShortString(d.directorate, 120)
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.createdAt == request.time
          && validSchool(request.resource.data);
        allow update: if isOwner(uid) && request.resource.data.createdAt == resource.data.createdAt
          && validSchool(request.resource.data);
      }

      // الأقسام/الأفواج — قائمة التلاميذ (roster) مضمّنة: فتح القسم = قراءة واحدة
      // فهرس الأقسام النشطة لكل سنة: وسيلة القواعد لعدّ الأقسام دون مسح المجموعة
      match /yearIndex/{yearId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && yearId.matches('^[0-9]{4}-[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['classIds', 'updatedAt'])
          && request.resource.data.classIds is list
          && request.resource.data.updatedAt == request.time
          && (
            // النقصان حر (أرشفة/حذف)، والزيادة حتى حدّ الخطة
            (resource != null && resource.data.classIds.hasAll(request.resource.data.classIds))
            || request.resource.data.classIds.size() <= maxClasses(uid)
          );
        allow delete: if false;
      }

      match /classes/{classId} {
        // قسم نشط أُخرج من الفهرس يصبح للقراءة فقط (لا فائدة من التحايل على الحد)؛
        // الأقسام القديمة قبل وجود الفهرس تبقى تعمل.
        function inIndexOrArchived(d) {
          let idx = /databases/$(database)/documents/teachers/$(uid)/yearIndex/$(d.yearId);
          return d.archived == true || !existsAfter(idx) || getAfter(idx).data.classIds.hasAny([classId]);
        }
        function validClass(d) {
          return d.yearId is string && d.yearId.matches('^[0-9]{4}-[0-9]{4}$')
            && isShortString(d.schoolId, 40)
            && d.stage in ['primary', 'middle', 'secondary']
            && isShortString(d.level, 8) && d.level.size() > 0
            && isShortString(d.section, 8)
            && isShortString(d.displayName, 40) && d.displayName.size() > 0
            && d.subjectIds is list && d.subjectIds.size() <= 20
            && d.archived is bool
            && (d.copiedFrom == null || isShortString(d.copiedFrom, 40))
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'yearId', 'schoolId', 'stage', 'level', 'section', 'displayName', 'subjectIds',
               'roster', 'studentCount', 'archived', 'copiedFrom', 'createdAt', 'updatedAt'])
          && request.resource.data.roster == []
          && request.resource.data.studentCount == 0
          && request.resource.data.archived == false
          && request.resource.data.createdAt == request.time
          && validClass(request.resource.data)
          // حدّ الخطة: القسم الجديد مُدرج في فهرس السنة (الذي لا يتجاوز الحد) في نفس الدفعة
          && getAfter(/databases/$(database)/documents/teachers/$(uid)/yearIndex/$(request.resource.data.yearId)).data.classIds.hasAny([classId]);
        // القائمة: حتى 60 تلميذًا، والعدّاد يطابق طولها دائمًا
        allow update: if isOwner(uid)
          && changedOnly(['displayName', 'subjectIds', 'archived', 'roster', 'studentCount', 'updatedAt'])
          && request.resource.data.roster is list
          && request.resource.data.roster.size() <= 60
          && request.resource.data.studentCount == request.resource.data.roster.size()
          && validClass(request.resource.data)
          && inIndexOrArchived(request.resource.data);
        // الحذف النهائي لقسم فارغ فقط؛ غير ذلك أرشفة
        allow delete: if isOwner(uid) && resource.data.studentCount == 0;
      }

      // الإسنادات: قسم × مادة، بمعرّف ثابت {classId}__{subjectId}
      match /assignments/{assignmentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'yearId', 'schoolId', 'stage', 'classId', 'level', 'subjectId', 'createdAt', 'updatedAt'])
          && assignmentId == request.resource.data.classId + '__' + request.resource.data.subjectId
          && request.resource.data.yearId is string && request.resource.data.yearId.matches('^[0-9]{4}-[0-9]{4}$')
          && isShortString(request.resource.data.schoolId, 40)
          && request.resource.data.stage in ['primary', 'middle', 'secondary']
          && isShortString(request.resource.data.level, 8)
          && isShortString(request.resource.data.subjectId, 32)
          && request.resource.data.updatedAt == request.time;
      }

      // الحصص (حضور + لاحقًا الدرس): الاستثناءات فقط في خريطة attendance
      match /sessions/{sessionKey} {
        function validSession(d) {
          return d.keys().hasOnly(['date', 'classId', 'part', 'status', 'attendance', 'counts', 'rosterSize', 'lesson', 'createdAt', 'updatedAt'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && isShortString(d.classId, 40)
            && isShortString(d.part, 60)
            && sessionKey == d.date + '_' + d.classId + '_' + d.part
            && d.status in ['held', 'cancelled']
            && d.attendance is map && d.attendance.size() <= 60
            && d.counts is map && d.counts.keys().hasOnly(['p', 'a', 'l', 'e'])
            && d.rosterSize is int && d.rosterSize >= 0 && d.rosterSize <= 60
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.createdAt == request.time
          && validSession(request.resource.data);
        allow update: if isOwner(uid) && request.resource.data.createdAt == resource.data.createdAt
          && validSession(request.resource.data);
      }

      // إحصائيات الحضور التراكمية لكل قسم (زيادات increment)
      match /attendanceStats/{classId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['sessions', 's', 'm', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // جدول التوقيت: مستند واحد لكل سنة، الحصص في قائمة
      match /schedules/{yearId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && yearId.matches('^[0-9]{4}-[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['yearId', 'slots', 'updatedAt'])
          && request.resource.data.yearId == yearId
          && request.resource.data.slots is list
          && request.resource.data.slots.size() <= 80
          && request.resource.data.updatedAt == request.time;
      }

      // الدفتر اليومي: سطر لكل حصة (مفتاحه التاريخ_القسم_المادة_الساعة)
      match /lessons/{lessonKey} {
        function validLesson(d) {
          return d.keys().hasOnly(['date', 'classId', 'subjectId', 'start', 'end', 'activity', 'unit', 'title', 'objective', 'materials', 'notes', 'status', 'updatedAt'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && isShortString(d.classId, 40) && isShortString(d.subjectId, 32)
            && d.start is string && d.start.matches('^[0-2][0-9]:[0-5][0-9]$')
            && d.end is string && d.end.matches('^[0-2][0-9]:[0-5][0-9]$')
            && lessonKey == d.date + '_' + d.classId + '_' + d.subjectId + '_' + d.start.replace(':', '')
            && (!('activity' in d) || isShortString(d.activity, 120))
            && isShortString(d.unit, 120) && isShortString(d.title, 200) && isShortString(d.objective, 300)
            && isShortString(d.materials, 200) && isShortString(d.notes, 400)
            && d.status in ['done', 'partial', 'notDone']
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLesson(request.resource.data);
      }

      // دفتر التكوين والندوات
      match /trainings/{trainingId} {
        function validTraining(d) {
          return d.keys().hasOnly(['date', 'kind', 'topic', 'place', 'lesson', 'practitioner', 'level', 'supervisor', 'domain', 'notes', 'updatedAt'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.kind in ['seminar', 'studyDay', 'internship']
            && isShortString(d.topic, 200) && d.topic.size() > 0
            && isShortString(d.place, 120) && isShortString(d.lesson, 200) && isShortString(d.practitioner, 120)
            && isShortString(d.level, 60) && isShortString(d.supervisor, 120)
            && d.domain in ['', 'legislation', 'classManagement', 'pedagogy', 'ethics', 'ict', 'didactics', 'mediation', 'system']
            && isShortString(d.notes, 3000)
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTraining(request.resource.data);
      }

      // دفتر التحضير: مذكرات الدروس بمراحلها الثلاث
      match /preps/{prepId} {
        function validPhase(p) {
          return p is map && p.keys().hasOnly(['situation', 'assessment'])
            && isShortString(p.situation, 4000) && isShortString(p.assessment, 1500);
        }
        function validPrep(d) {
          return d.keys().hasOnly(['subjectId', 'gradeId', 'domain', 'sequence', 'activity', 'week', 'content', 'session',
                                   'objective', 'values', 'materials', 'phases', 'date', 'updatedAt'])
            && isShortString(d.subjectId, 32) && isShortString(d.gradeId, 32)
            && isShortString(d.domain, 120) && isShortString(d.sequence, 120) && isShortString(d.activity, 120)
            && isShortString(d.week, 20) && isShortString(d.content, 200) && isShortString(d.session, 20)
            && isShortString(d.objective, 500) && isShortString(d.values, 300) && isShortString(d.materials, 300)
            && d.phases is map && d.phases.keys().hasOnly(['launch', 'build', 'invest'])
            && validPhase(d.phases.launch) && validPhase(d.phases.build) && validPhase(d.phases.invest)
            && (d.date == '' || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPrep(request.resource.data);
      }

      // بطاقة الحالة الشخصية والمهنية: بيانات خاصة لا يقرؤها إلا صاحبها
      match /private/{docId} {
        function validCard(d) {
          return docId == 'card'
            && d.keys().hasOnly(['birthDate', 'birthPlace', 'birthWilaya', 'familyStatus', 'spouseJob', 'address', 'phone', 'teachingLanguage', 'firstDay', 'schoolAppointment', 'lastInspection', 'inspector', 'step', 'stepDate', 'updatedAt'])
            && d.keys().hasAll(['birthDate', 'birthPlace', 'birthWilaya', 'familyStatus', 'spouseJob', 'address', 'phone', 'teachingLanguage', 'firstDay', 'schoolAppointment', 'lastInspection', 'inspector', 'step', 'stepDate'])
            && isShortString(d.birthDate, 10) && isShortString(d.birthPlace, 120) && isShortString(d.birthWilaya, 120)
            && isShortString(d.familyStatus, 120) && isShortString(d.spouseJob, 120) && isShortString(d.address, 120)
            && isShortString(d.phone, 120) && isShortString(d.teachingLanguage, 120) && isShortString(d.firstDay, 10)
            && isShortString(d.schoolAppointment, 10) && isShortString(d.lastInspection, 10) && isShortString(d.inspector, 120)
            && isShortString(d.step, 120) && isShortString(d.stepDate, 10)
            && d.updatedAt == request.time;
        }
        allow read: if isOwner(uid) && docId == 'card';
        allow create, update: if isOwner(uid) && validCard(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // دفتر التنقيط: كشف علامات قسم في فصل — لا يقرؤه إلا الأستاذ
      match /grades/{docId} {
        function validGrades(d) {
          return d.keys().hasOnly(['classId', 'term', 'marks', 'updatedAt'])
            && isShortString(d.classId, 40)
            && d.term in [1, 2, 3]
            && docId == d.classId + '__t' + string(d.term)
            && d.marks is map && d.marks.size() <= 60
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGrades(request.resource.data);
      }

      // التوزيع السنوي لكل قسم ومادة
      match /progressions/{pid} {
        function validProgression(d) {
          return d.keys().hasOnly(['classId', 'subjectId', 'startDate', 'rows', 'updatedAt'])
            && isShortString(d.classId, 40) && isShortString(d.subjectId, 32)
            && pid == d.classId + '__' + d.subjectId
            && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.rows is list && d.rows.size() <= 200
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgression(request.resource.data);
      }

      // إشعارات شخصية (تفعيل الاشتراك…) يكتبها الخادم وحده
      match /notifications/{nid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      // رموز أجهزة إشعارات الهاتف: يديرها الخادم وحده (لا قراءة ولا كتابة من المتصفح)
      match /pushTokens/{tokenId} {
        allow read, write: if false;
      }
      // تاريخ آخر قراءة للإشعارات (والخادم يحدّث تاريخ آخر إشعار شخصي)
      match /prefs/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && docId == 'notifications'
          && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
        allow update: if isOwner(uid) && docId == 'notifications'
          && changedOnly(['readAt']) && request.resource.data.readAt == request.time;
      }

      // السنوات الدراسية للأستاذ — المعرّف هو معرّف السنة نفسه (2026-2027)
      match /years/{yearId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && yearId.matches('^[0-9]{4}-[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['academicYearId', 'label', 'status', 'createdAt'])
          && request.resource.data.academicYearId == yearId
          && isShortString(request.resource.data.label, 16)
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && changedOnly(['status'])
          && request.resource.data.status in ['active', 'archived'];
        allow delete: if false;
      }
    }

    // ── بيانات مرجعية عامّة يديرها الأدمن ────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      // المحرّر الذي ينشر محتوى مع إشعار يحدّث تاريخ آخر إعلان فقط
      allow update: if isEditor() && doc == 'app' && changedOnly(['latestAnnouncementAt'])
        && request.resource.data.latestAnnouncementAt == request.time;
    }

    // ── الإشعارات العامة (من الإدارة) ──
    match /announcements/{id} {
      function validAnnouncement(d) {
        return d.keys().hasOnly(['title', 'body', 'link', 'kind', 'createdAt', 'createdBy'])
          && d.title is map && isShortString(d.title.ar, 140) && isShortString(d.title.fr, 140)
          && (d.title.ar.size() > 0 || d.title.fr.size() > 0)
          && d.body is map && isShortString(d.body.ar, 1000) && isShortString(d.body.fr, 1000)
          && isShortString(d.link, 300) && (d.link == '' || d.link.matches('^(/[^/\\\\].*|/|https://.+)$'))
          && d.kind in ['news', 'update', 'content', 'offer']
          && d.createdAt == request.time && d.createdBy == request.auth.uid;
      }
      allow read: if signedIn();
      allow create: if (isAdmin() || (isEditor() && request.resource.data.kind == 'content')) && validAnnouncement(request.resource.data);
      allow update: if isAdmin() && validAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }
    match /taxonomy/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /academicYears/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // ── مكتبة المحتوى ──
    // البيانات الوصفية للمنشور عامة (للتصفّح والتسويق)؛ الملفات نفسها لا تُقدَّم
    // إلا عبر /api/files بعد التحقق من الحساب والاشتراك على الخادم.
    match /contents/{id} {
      function validContent(d) {
        return d.keys().hasOnly(['title', 'stage', 'level', 'subject', 'language', 'type', 'term', 'unit', 'tags', 'excerpt',
                                 'access', 'author', 'license', 'files', 'previewKey', 'status', 'publishedAt', 'updatedAt'])
          && d.title is map && isShortString(d.title.ar, 200) && isShortString(d.title.fr, 200)
          && (d.title.ar.size() > 0 || d.title.fr.size() > 0)
          && d.stage in ['primary', 'middle', 'secondary']
          && isShortString(d.level, 16) && isShortString(d.subject, 32)
          && d.language in ['ar', 'fr', 'en']
          && isShortString(d.type, 32)
          && d.term in [0, 1, 2, 3]
          && isShortString(d.unit, 120) && isShortString(d.excerpt, 1000)
          && d.tags is list && d.tags.size() <= 20
          && d.access in ['free', 'premium']
          && isShortString(d.author, 120) && d.license in ['original', 'licensed', 'public']
          && d.files is list && d.files.size() <= 10
          && isShortString(d.previewKey, 200)
          && d.status in ['draft', 'published', 'archived']
          && (d.publishedAt == null || d.publishedAt is int)
          && d.updatedAt == request.time;
      }
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update: if isEditor() && validContent(request.resource.data);
      allow delete: if isEditor();
    }
    // فهرس البحث: وثيقة واحدة لكل مرحلة تحمل سطرًا مختصرًا لكل محتوى منشور
    match /contentIndex/{stage} {
      allow read: if true;
      allow write: if isEditor()
        && stage in ['primary', 'middle', 'secondary']
        && request.resource.data.keys().hasOnly(['entries', 'updatedAt'])
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 3000
        && request.resource.data.updatedAt == request.time;
    }

    match /contentCategories/{doc} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ── الاشتراك والمال: قراءة للمالك، والكتابة للخادم وحده ──
    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if isOwner(resource.data.uid) || isFinance();
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if isOwner(resource.data.uid) || isFinance();
      allow write: if false;
    }
    // ── التواصل مع الإدارة: محادثة واحدة لكل أستاذ ──
    match /supportThreads/{uid} {
      function threadFields() {
        return ['uid', 'name', 'email', 'lastMessage', 'lastMessageAt', 'lastFrom', 'unreadAdmin', 'unreadTeacher', 'status'];
      }
      // الأستاذ يرسل: تحديث ملخص المحادثة بآخر رسالته فقط
      function teacherSend(d) {
        return d.keys().hasOnly(threadFields())
          && d.uid == uid && isShortString(d.name, 130) && isShortString(d.email, 200)
          && isShortString(d.lastMessage, 140) && d.lastMessageAt == request.time
          && d.lastFrom == 'teacher' && d.unreadAdmin == true && d.unreadTeacher == false && d.status == 'open';
      }
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && teacherSend(request.resource.data));
      allow update: if isAdmin()
        || (isOwner(uid) && (teacherSend(request.resource.data)
            || (changedOnly(['unreadTeacher']) && request.resource.data.unreadTeacher == false)));
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time
          && ((isOwner(uid) && request.resource.data.from == 'teacher') || (isAdmin() && request.resource.data.from == 'admin'));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // الإيرادات المجمّعة شهريًا (يكتبها الخادم عند كل دفعة مؤكّدة)
    match /stats/{id} {
      allow read: if isFinance();
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // كل ما لم يُذكر أعلاه مغلق.
  }
}
